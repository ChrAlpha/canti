+		}
+		d.scanEvents([]byte(strings.Repeat("x", DefaultDiscardLimit-len(suffix))+suffix), false)
+		if !errors.Is(d.limitErr, ErrInputLimit) {
+			t.Fatalf("suffix=%q budget exhaustion did not terminate", suffix)
