+func TestPasteDiscardBudgetIncludesUnfinishedDelimiter(t *testing.T) {
+	for _, suffix := range []string{"", "\x1b[20"} {
+		d := newEventScanner()
+		d.maxPasteBytes = 8
+		d.scanEvents([]byte("\x1b[200~123456789"), false)
+		if !d.pasteOverflow {
